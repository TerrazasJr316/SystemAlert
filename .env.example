# ─────────────────────────────────────────
# SystemAlert — Variables de Entorno (ejemplo)
# Copiar este archivo como .env y ajustar valores
# ─────────────────────────────────────────

# ─── PostgreSQL ───
POSTGRES_DB=c5db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ─── Redis ───
REDIS_HOST=redis
REDIS_PORT=6379

# ─── MQTT ───
MQTT_BROKER=mosquitto
MQTT_PORT=1883

# ─── Redis Streams ───
REDIS_STREAM=alerts-stream
NOTIF_STREAM=notifications-stream

# ─── MS2 — Consumer Group ───
MS2_CONSUMER_GROUP=ms2-group
MS2_CONSUMER_NAME=ms2-consumer-1

# ─── MS3 — gRPC ───
MS3_HOST=ms3
MS3_GRPC_PORT=50051

# ─── MS4 — WebSocket ───
MS4_WS_PORT=4000
MS4_CONSUMER_GROUP=ms4-group
MS4_CONSUMER_NAME=ms4-consumer-1

# ─── MS5 — REST API ───
MS5_PORT=5000

# ─── PostgreSQL Conexión ───
PG_MASTER_HOST=postgres-master
PG_REPLICA_HOST=postgres-replica
PG_PORT=5432

# ─── Frontend (build-time) ───
VITE_MS4_URL=http://localhost:4000
VITE_MS5_URL=http://localhost:5000
